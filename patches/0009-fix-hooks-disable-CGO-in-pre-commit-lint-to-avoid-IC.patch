From e2f410133b9e9a41e25d7052b570d48851005628 Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Mon, 13 Apr 2026 16:04:23 -0400
Subject: [PATCH 09/18] fix(hooks): disable CGO in pre-commit lint to avoid ICU
 header errors

golangci-lint's typecheck fails on macOS when icu4c headers aren't
installed, because go-icu-regex requires unicode/regex.h. Since the
linter only needs to analyze Go code (not compile CGO), CGO_ENABLED=0
avoids the issue entirely.

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
---
 .githooks/pre-commit | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/.githooks/pre-commit b/.githooks/pre-commit
index 32f345638..c666ecd35 100755
--- a/.githooks/pre-commit
+++ b/.githooks/pre-commit
@@ -17,9 +17,6 @@ GOLANGCI_LINT="go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.
 echo "$staged_go_files" | xargs gofmt -w
 echo "$staged_go_files" | xargs git add
 
-# Lint changed code with auto-fix; block on remaining issues.
-# CGO_ENABLED=0 avoids typecheck failures from CGO-only dependencies
-# (e.g., dolthub/go-icu-regex) that require system headers not always present.
 CGO_ENABLED=0 $GOLANGCI_LINT run --new-from-rev=HEAD --fix || exit 1
 
 # Re-stage any auto-fixes from the linter
-- 
2.50.1 (Apple Git-155)

