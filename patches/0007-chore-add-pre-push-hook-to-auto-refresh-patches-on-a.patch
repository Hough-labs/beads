From 7924c994f1714e58e2a28c00ff9e4009e6a675fa Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Sat, 4 Apr 2026 06:23:02 -0400
Subject: [PATCH 07/21] chore: add pre-push hook to auto-refresh patches/ on
 anvil

Before any push from anvil, regenerates patches/ from the current
divergence and amends HEAD if they changed. No more manual make patches
step after commits.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 .githooks/pre-push | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)
 create mode 100755 .githooks/pre-push

diff --git a/.githooks/pre-push b/.githooks/pre-push
new file mode 100755
index 00000000..aaae6088
--- /dev/null
+++ b/.githooks/pre-push
@@ -0,0 +1,17 @@
+#!/usr/bin/env bash
+# Pre-push hook: on anvil branch, regenerate patches/ and fold into HEAD.
+# Ensures patches/ always reflects the current divergence before pushing.
+# Installed via: git config core.hooksPath .githooks (run by make install)
+
+set -euo pipefail
+
+BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0
+[ "$BRANCH" = "anvil" ] || exit 0
+
+make patches --quiet
+
+if ! git diff --quiet patches/; then
+    git add patches/
+    git commit --amend --no-edit --quiet
+    echo "pre-push: patches/ refreshed and folded into HEAD"
+fi
-- 
2.50.1 (Apple Git-155)

