From 56971bb3d0ba796e347cbb5112cd9867992ca171 Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Sun, 31 May 2026 14:59:09 -0400
Subject: [PATCH 12/19] build: rebase-based upgrade flow with mise cleanup and
 patch-system fixes

Squashed upgrade-tooling refinements:
- sweep mise cleanup; trigger Anvil rebuild from pre-push
- eliminate recursive patch self-inclusion + pre-push amend bug
- copy patches to tmpdir before reset
- rebase-based upgrade, robust anvil sync

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 .githooks/pre-push       | 82 ++++++++++++++++++++++++++++++++++----
 Makefile                 | 13 ++----
 scripts/upgrade-anvil.sh | 86 ++++++++++++++++++++++------------------
 3 files changed, 125 insertions(+), 56 deletions(-)

diff --git a/.githooks/pre-push b/.githooks/pre-push
index c45d8f1e6..a82b31fb1 100755
--- a/.githooks/pre-push
+++ b/.githooks/pre-push
@@ -1,6 +1,6 @@
 #!/usr/bin/env bash
-# Pre-push hook: on anvil branch, regenerate patches/ and fold into HEAD.
-# Ensures patches/ always reflects the current divergence before pushing.
+# Pre-push hook: on anvil branch, validate patches/ is current, rebuild+install
+# locally, then kick off a remote rebuild on Anvil so both machines converge.
 # Installed via: git config core.hooksPath .githooks (run by make install)
 
 set -euo pipefail
@@ -8,14 +8,80 @@ set -euo pipefail
 BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0
 [ "$BRANCH" = "anvil" ] || exit 0
 
-make patches --quiet
-
-if ! git diff --quiet patches/; then
-    git add patches/
-    git commit --amend --no-edit --quiet
-    echo "pre-push: patches/ refreshed and folded into HEAD"
+# --- Validate patches/ is up-to-date ---
+TMPDIR=$(mktemp -d)
+trap 'rm -rf "$TMPDIR"' EXIT
+git format-patch upstream/main..HEAD --output-directory "$TMPDIR" -- . ':!patches/' >/dev/null 2>&1
+# Compare patch count and diff bodies, ignoring "From <sha>" headers which
+# change on every amend.
+EXPECTED=$(ls "$TMPDIR"/*.patch 2>/dev/null | wc -l | tr -d ' ')
+ACTUAL=$(ls patches/*.patch 2>/dev/null | wc -l | tr -d ' ')
+if [ "$EXPECTED" != "$ACTUAL" ]; then
+    rm -rf "$TMPDIR"
+    echo ""
+    echo "pre-push: patches/ has $ACTUAL patches but $EXPECTED expected. Run:"
+    echo "  make patches && git add patches/ && git commit --amend --no-edit"
+    echo "Then push again."
+    exit 1
+fi
+# Compare diff bodies (skip From line which contains the commit SHA)
+STALE=0
+for f in "$TMPDIR"/*.patch; do
+    base=$(basename "$f")
+    if [ ! -f "patches/$base" ] || ! diff <(tail -n +2 "patches/$base") <(tail -n +2 "$f") >/dev/null 2>&1; then
+        STALE=1
+        break
+    fi
+done
+if [ "$STALE" = "1" ]; then
+    echo ""
+    echo "pre-push: patches/ is stale. Run:"
+    echo "  make patches && git add patches/ && git commit --amend --no-edit"
+    echo "Then push again."
+    exit 1
 fi
 
 # --- Build and install to ~/go/bin ---
 echo "beads: rebuilding and installing to ~/go/bin..."
 make install-force
+
+# --- Sync to Anvil ---
+# Only trigger from Hammer (Darwin). Background job polls origin/anvil until
+# it sees our pushed SHA, then SSHes anvil to pull+build. Failure is logged,
+# not fatal — the local push still succeeds.
+if [ "$(uname -s)" = "Darwin" ]; then
+    EXPECTED_SHA=$(git rev-parse HEAD)
+    LOG="$HOME/.cache/sync-anvil.log"
+    mkdir -p "$(dirname "$LOG")"
+    (
+        exec >>"$LOG" 2>&1
+        echo "[$(date '+%F %T')] beads sync-anvil: waiting for origin/anvil to reach $EXPECTED_SHA"
+        # Remote script: pull, rebuild, install. Piped to bash -s because anvil's
+        # default login shell is fish, which can't parse POSIX/bash scripts.
+        REMOTE_CMD='
+set -e
+cd ~/code/forks/gastownhall/beads
+git fetch origin anvil --quiet
+git reset --hard origin/anvil --quiet
+make install-force
+'
+        for _ in $(seq 1 30); do
+            REMOTE_SHA=$(git ls-remote --quiet origin refs/heads/anvil 2>/dev/null | awk '{print $1}')
+            if [ "$REMOTE_SHA" = "$EXPECTED_SHA" ]; then
+                echo "[$(date '+%F %T')] beads sync-anvil: origin reached $EXPECTED_SHA — triggering remote build"
+                printf '%s\n' "$REMOTE_CMD" | ssh -o BatchMode=yes anvil bash -s
+                RC=$?
+                if [ "$RC" -eq 0 ]; then
+                    echo "[$(date '+%F %T')] beads sync-anvil: done"
+                else
+                    echo "[$(date '+%F %T')] beads sync-anvil: remote deploy failed (rc=$RC)"
+                fi
+                exit "$RC"
+            fi
+            sleep 2
+        done
+        echo "[$(date '+%F %T')] beads sync-anvil: timeout — origin/anvil did not advance. Run manually on anvil: cd ~/code/forks/gastownhall/beads && git pull && make install-force"
+    ) </dev/null &
+    disown
+    echo "pre-push: anvil sync backgrounded (tail $LOG for progress)"
+fi
diff --git a/Makefile b/Makefile
index 3aefbe0a0..389cc2e35 100644
--- a/Makefile
+++ b/Makefile
@@ -162,19 +162,14 @@ else
 	@rm -f $(INSTALL_DIR)/beads
 	@ln -sf bd $(INSTALL_DIR)/beads
 	@echo "Created 'beads' alias -> bd"
-	@# Clean stale copies from previous install locations (including mise Go paths)
+	@# Sweep stale binaries from the upstream default install location.
+	@# -e || -L catches dangling symlinks too (e.g. beads -> bd after bd was removed).
 	@for stale in $(HOME)/.local/bin/bd $(HOME)/.local/bin/beads; do \
-		if [ -f "$$stale" ] && [ "$$stale" != "$(INSTALL_DIR)/bd" ] && [ "$$stale" != "$(INSTALL_DIR)/beads" ]; then \
+		if { [ -e "$$stale" ] || [ -L "$$stale" ]; } && [ "$$stale" != "$(INSTALL_DIR)/bd" ] && [ "$$stale" != "$(INSTALL_DIR)/beads" ]; then \
 			echo "Removing stale $$stale"; \
 			rm -f "$$stale"; \
 		fi; \
 	done
-	@for stale in $(HOME)/.local/share/mise/installs/go/*/bin/bd; do \
-		if [ -f "$$stale" ] || [ -L "$$stale" ]; then \
-			echo "Removing stale mise binary $$stale"; \
-			rm -f "$$stale"; \
-		fi; \
-	done
 endif
 	@git config core.hooksPath .githooks 2>/dev/null && echo "Configured git hooks (.githooks/)" || true
 
@@ -227,7 +222,7 @@ clean-test-tmp:
 patches:
 	@echo "Exporting patches from anvil -> upstream/main divergence..."
 	@rm -f patches/*.patch
-	@git format-patch upstream/main..HEAD --output-directory patches/
+	@git format-patch upstream/main..HEAD --output-directory patches/ -- . ':!patches/'
 	@echo "Patches written to patches/:"
 	@ls patches/*.patch 2>/dev/null | sed 's|patches/||'
 
diff --git a/scripts/upgrade-anvil.sh b/scripts/upgrade-anvil.sh
index 5ce287fae..9350f10da 100755
--- a/scripts/upgrade-anvil.sh
+++ b/scripts/upgrade-anvil.sh
@@ -1,15 +1,18 @@
 #!/usr/bin/env bash
-# scripts/upgrade-anvil.sh — upgrade anvil to latest upstream and replay patches
+# scripts/upgrade-anvil.sh — rebase local patches onto latest upstream.
 #
 # Usage: make upgrade
 #
-# What it does:
-#   1. Guards: clean tree, correct branch
-#   2. Shows what's incoming from upstream
-#   3. Resets anvil to upstream/main
-#   4. Replays patches/*.patch via git am
-#   5. On conflict: prints clear resume/abort instructions and exits 1
-#   6. On success: offers to build and install
+# Rebase-based (no local reset --hard). Remote anvil still gets reset --hard to
+# origin/anvil via the pre-push hook — that's required to keep the remote
+# checkout in sync with origin, and happens over ssh, not locally.
+#
+# Flow:
+#   1. Guards: clean tree, correct branch, upstream reachable
+#   2. Fetch upstream, show incoming commits
+#   3. git rebase upstream/main (preserves local patch commits; conflicts pause)
+#   4. make patches (regen from new SHAs) + amend last commit if diff
+#   5. Optional interactive push (force-with-lease) to trigger deploy
 
 set -euo pipefail
 
@@ -43,8 +46,8 @@ PATCH_COUNT=$(find patches/ -maxdepth 1 -name '*.patch' 2>/dev/null | wc -l | tr
 info "Fetching upstream..."
 git fetch upstream --quiet
 
-INCOMING=$(git log --oneline HEAD..upstream/main 2>/dev/null)
-INCOMING_COUNT=$(echo "$INCOMING" | grep -c . || true)
+INCOMING=$(git log --oneline HEAD..upstream/main 2>/dev/null || true)
+INCOMING_COUNT=$(echo -n "$INCOMING" | grep -c '^' || true)
 
 if [ "$INCOMING_COUNT" -eq 0 ]; then
     ok "Already up to date with upstream/main"
@@ -53,60 +56,65 @@ fi
 
 echo ""
 echo -e "${BLU}Incoming from upstream ($INCOMING_COUNT commits):${RST}"
-echo "$INCOMING" | while read -r line; do dim "  $line"; done
+echo "$INCOMING" | head -20 | while read -r line; do dim "  $line"; done
+[ "$INCOMING_COUNT" -gt 20 ] && dim "  ... and $((INCOMING_COUNT - 20)) more"
 echo ""
 
-# ── Reset and replay ─────────────────────────────────────────────────────────
-
-info "Resetting anvil to upstream/main..."
-git reset --hard upstream/main --quiet
-ok "Reset to $(git rev-parse --short HEAD) ($(git log -1 --format='%s'))"
-
-echo ""
-info "Replaying $PATCH_COUNT local patches..."
-echo ""
+# ── Rebase local patches onto upstream/main ──────────────────────────────────
 
-PATCH_NUM=0
-for patch in patches/*.patch; do
-    PATCH_NUM=$((PATCH_NUM + 1))
-    SUBJECT=$(grep '^Subject:' "$patch" | sed 's/Subject: \[PATCH[^]]*\] //')
-    printf "  ${DIM}Applying %d/%d: %s${RST}\n" "$PATCH_NUM" "$PATCH_COUNT" "$SUBJECT"
-done
+LOCAL_COMMITS=$(git rev-list --count upstream/main..HEAD)
+info "Rebasing $LOCAL_COMMITS local patch commit(s) onto upstream/main..."
 echo ""
 
-if ! git am patches/*.patch; then
+if ! git rebase upstream/main; then
     echo ""
     die "$(cat <<'EOF'
-Patch conflict — resolve then continue:
+Rebase conflict — resolve then continue:
 
   1. Edit the conflicting file(s)
   2. git add <file>
-  3. git am --continue
+  3. git rebase --continue
 
-To bail out entirely:
-  git am --abort
-  git reset --hard upstream/main
+To bail out (safe — no reset --hard has occurred):
+  git rebase --abort
 EOF
 )"
 fi
 
+ok "All $LOCAL_COMMITS patches preserved — anvil now at $(git describe --tags HEAD 2>/dev/null || git rev-parse --short HEAD)"
 echo ""
-ok "All $PATCH_COUNT patches applied"
-ok "anvil is now at $(git rev-parse --short HEAD)"
+
+# ── Regenerate patches/ from new SHAs ────────────────────────────────────────
+
+info "Regenerating patches/ from new SHAs..."
+make patches >/dev/null
+
+if ! git diff --quiet patches/; then
+    info "Amending tip commit with refreshed patches/..."
+    git add patches/
+    git commit --amend --no-edit --quiet
+    ok "Amended — tree clean"
+else
+    dim "  patches/ already current (no amend needed)"
+fi
 echo ""
 
-# ── Optional build ───────────────────────────────────────────────────────────
+# ── Optional push ────────────────────────────────────────────────────────────
 
 if [ -t 0 ]; then
-    read -rp "$(echo -e "${BLU}▸${RST} Build and install now? [Y/n] ")" REPLY
+    read -rp "$(echo -e "${BLU}▸${RST} Push to origin and deploy (force-with-lease)? [Y/n] ")" REPLY
     REPLY=${REPLY:-Y}
     if [[ "$REPLY" =~ ^[Yy]$ ]]; then
         echo ""
-        make install
+        git push --force-with-lease origin anvil
+        echo ""
+        info "Anvil sync backgrounded — tail: ~/.cache/sync-anvil.log"
+    else
+        dim "  Skipped. Run: git push --force-with-lease origin anvil"
     fi
 else
-    dim "  (non-interactive — skipping build prompt)"
-    dim "  Run 'make install' when ready"
+    dim "  (non-interactive — skipping push prompt)"
+    dim "  Run: git push --force-with-lease origin anvil"
 fi
 
 echo ""
