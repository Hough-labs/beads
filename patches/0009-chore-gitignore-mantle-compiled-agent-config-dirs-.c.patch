From 281c59ae035830fa2d86f39074c2bfc101993553 Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Mon, 6 Apr 2026 05:23:14 -0400
Subject: [PATCH 09/21] chore: gitignore mantle-compiled agent config dirs
 (.claude, .agents, .pi)

These are generated by `mantle persona build` and should not be committed.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 .gitignore | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/.gitignore b/.gitignore
index d364b9fe..c0be7195 100644
--- a/.gitignore
+++ b/.gitignore
@@ -133,3 +133,6 @@ bd_test
 
 # Beads / Dolt files (added by bd init)
 .beads-credential-key
+
+# Mantle-compiled agent config (generated, do not commit)
+.pi/
-- 
2.50.1 (Apple Git-155)

