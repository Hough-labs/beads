From a3028bd0e6c4764ac016fac96ccafff1b10062c7 Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Thu, 16 Apr 2026 19:03:26 -0400
Subject: [PATCH 18/21] build: sweep mise cleanup; trigger Anvil rebuild from
 pre-push
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

After migrating off mise, the stale-binary cleanup loop that swept
~/.local/share/mise/installs/go/*/bin/bd is dead code — drop it.
Kept the ~/.local/bin/{bd,beads} sweep since that's still useful
when upgrading from pre-migration installs.

Pre-push hook now trails the local build+install with a backgrounded
SSH to anvil that polls origin/anvil, waits for the pushed SHA to
appear, then runs make install-force there. Keeps Hammer and Anvil
on the same commit without a separate deploy step. Failure is
logged (~/.cache/sync-anvil.log), not fatal.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 .githooks/pre-push | 32 ++++++++++++++++++++++++++++++--
 Makefile           | 11 +++--------
 2 files changed, 33 insertions(+), 10 deletions(-)

diff --git a/.githooks/pre-push b/.githooks/pre-push
index c45d8f1e..b968f021 100755
--- a/.githooks/pre-push
+++ b/.githooks/pre-push
@@ -1,6 +1,7 @@
 #!/usr/bin/env bash
-# Pre-push hook: on anvil branch, regenerate patches/ and fold into HEAD.
-# Ensures patches/ always reflects the current divergence before pushing.
+# Pre-push hook: on anvil branch, regenerate patches/ and fold into HEAD,
+# rebuild+install locally, then kick off a remote rebuild on Anvil so both
+# machines converge on the same binary.
 # Installed via: git config core.hooksPath .githooks (run by make install)
 
 set -euo pipefail
@@ -19,3 +20,30 @@ fi
 # --- Build and install to ~/go/bin ---
 echo "beads: rebuilding and installing to ~/go/bin..."
 make install-force
+
+# --- Sync to Anvil ---
+# Only trigger from Hammer (Darwin). Background job polls origin/anvil until
+# it sees our pushed SHA, then SSHes anvil to pull+build. Failure is logged,
+# not fatal — the local push still succeeds.
+if [ "$(uname -s)" = "Darwin" ]; then
+    EXPECTED_SHA=$(git rev-parse HEAD)
+    LOG="$HOME/.cache/sync-anvil.log"
+    mkdir -p "$(dirname "$LOG")"
+    (
+        exec >>"$LOG" 2>&1
+        echo "[$(date '+%F %T')] beads sync-anvil: waiting for origin/anvil to reach $EXPECTED_SHA"
+        for _ in $(seq 1 30); do
+            REMOTE_SHA=$(git ls-remote --quiet origin refs/heads/anvil 2>/dev/null | awk '{print $1}')
+            if [ "$REMOTE_SHA" = "$EXPECTED_SHA" ]; then
+                echo "[$(date '+%F %T')] beads sync-anvil: origin reached $EXPECTED_SHA — triggering remote build"
+                ssh -o BatchMode=yes anvil "cd ~/code/forks/gastownhall/beads && git fetch origin anvil --quiet && git reset --hard origin/anvil --quiet && make install-force"
+                echo "[$(date '+%F %T')] beads sync-anvil: done"
+                exit 0
+            fi
+            sleep 2
+        done
+        echo "[$(date '+%F %T')] beads sync-anvil: timeout — origin/anvil did not advance. Run manually on anvil: cd ~/code/forks/gastownhall/beads && git pull && make install-force"
+    ) </dev/null &
+    disown
+    echo "pre-push: anvil sync backgrounded (tail $LOG for progress)"
+fi
diff --git a/Makefile b/Makefile
index b40acab6..86bd54f9 100644
--- a/Makefile
+++ b/Makefile
@@ -161,19 +161,14 @@ else
 	@rm -f $(INSTALL_DIR)/beads
 	@ln -sf bd $(INSTALL_DIR)/beads
 	@echo "Created 'beads' alias -> bd"
-	@# Clean stale copies from previous install locations (including mise Go paths)
+	@# Sweep stale binaries from the upstream default install location.
+	@# -e || -L catches dangling symlinks too (e.g. beads -> bd after bd was removed).
 	@for stale in $(HOME)/.local/bin/bd $(HOME)/.local/bin/beads; do \
-		if [ -f "$$stale" ] && [ "$$stale" != "$(INSTALL_DIR)/bd" ] && [ "$$stale" != "$(INSTALL_DIR)/beads" ]; then \
+		if { [ -e "$$stale" ] || [ -L "$$stale" ]; } && [ "$$stale" != "$(INSTALL_DIR)/bd" ] && [ "$$stale" != "$(INSTALL_DIR)/beads" ]; then \
 			echo "Removing stale $$stale"; \
 			rm -f "$$stale"; \
 		fi; \
 	done
-	@for stale in $(HOME)/.local/share/mise/installs/go/*/bin/bd; do \
-		if [ -f "$$stale" ] || [ -L "$$stale" ]; then \
-			echo "Removing stale mise binary $$stale"; \
-			rm -f "$$stale"; \
-		fi; \
-	done
 endif
 	@git config core.hooksPath .githooks 2>/dev/null && echo "Configured git hooks (.githooks/)" || true
 
