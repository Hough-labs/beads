 Makefile                 |  49 ++++++++++++-----
 scripts/upgrade-anvil.sh | 113 +++++++++++++++++++++++++++++++++++++++
 3 files changed, 166 insertions(+), 13 deletions(-)
 create mode 100755 .githooks/pre-push
